<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Athkar</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The Firebase service-account key. Git-ignored (it can push to every install
      of the app), so the Condition keeps the build working on a machine or CI
      runner that does not have it — push simply stays off there.
      Fcm:CredentialsPath resolves against the content root, which is the output
      directory for a published app, hence the copy.
    -->
    <None Update="athkar-notifications.json"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('athkar-notifications.json')" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Canonical Qur'an text pulled from the quran.ai MCP server by
      tools/quran-mcp/pull.py. QuranicAthkarSeeder reads these from the content
      root at startup rather than carrying the verses as C# literals, so a
      correction is a re-run of that script, not a retyping of a mushaf.
    -->
    <None Update="DataAccess/Seeders/Data/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FirebaseAdmin" Version="3.6.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

</Project>
