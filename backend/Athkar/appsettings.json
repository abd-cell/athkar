{
  "ConnectionStrings": {
    "Default": "Server=DESKTOP-SBF2I7A;Database=Athkar;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    // Deliberately empty. The signing key is a secret and this file is public,
    // so it is supplied out of band and the app refuses to start without one:
    //
    //   dotnet user-secrets set "Jwt:Secret" "<32+ random bytes>"   (development)
    //   Jwt__Secret=<...>                                           (deployment)
    //
    // Rotating it invalidates every issued token, which signs every console
    // session out — that is the intended effect, not a side effect.
    "Secret": "",
    "Issuer": "Athkar",
    "Audience": "Athkar",
    // Access tokens are deliberately short-lived; the console trades its refresh
    // token for a new one and only signs out when the refresh token itself lapses.
    "AccessMinutes": 60,
    "RefreshDays": 30
  },
  "Fcm": {
    // Push is optional. Drop the Firebase service-account JSON next to the app
    // and point CredentialsPath at it (or set Fcm__CredentialsJson in the
    // environment). With neither, reminders are still stored in each device's
    // inbox — they are simply not pushed.
    "Enabled": true,
    "CredentialsPath": "athkar-notifications.json",
    "CredentialsJson": "",
    "BatchSize": 500
  },
  "QuranMcp": {
    // The canonical Qur'an source (quran.ai, upstream quran.com). Off by
    // default: reaching out to a third party on an admin's click is a decision
    // a deployment makes, not one the binary makes for it. With this false the
    // sync endpoints answer QuranSourceDisabled and no request leaves the box.
    //
    // Note that "ar-uthmani" is NOT the Uthmani script — it comes back
    // undiacritised — which is why DisplayEdition names the minimal variant and
    // SearchEdition takes the plain one. See tools/quran-mcp/README.md.
    "Enabled": false,
    "BaseUrl": "https://mcp.quran.ai",
    "DisplayEdition": "ar-uthmani-minimal",
    "SearchEdition": "ar-uthmani",
    "EnglishEdition": "en-sahih-international",
    "TimeoutSeconds": 20
  },
  "Storage": {
    // Uploaded Qur'an packages. Relative to the content root and deliberately
    // outside wwwroot: a package is served through the versioned download
    // endpoint so the server can count it, never as static content.
    "Root": "App_Data/uploads",
    "MaxQuranPackageMb": 256
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
