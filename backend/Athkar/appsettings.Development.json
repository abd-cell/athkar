{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "QuranMcp": {
    // On for local work so the sync can actually be exercised. Production keeps
    // the default in appsettings.json, which is off.
    "Enabled": true
  },
  "Mp3Quran": {
    // On for local work so the reciter sync can be exercised.
    "Enabled": true
  },
  "Swagger": {
    // On for local work; Title/Version/Path fall through to appsettings.json's
    // defaults since only Enabled differs here.
    "Enabled": true
  }
}
